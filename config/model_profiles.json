      "experiments": {
        "banded_gamma": { "enabled": true }
      }
    },
    "exp_platt_calibration": {
      "description": "Phase 1 flag (off by default): rolling Platt scaling fitted on the previous 150-300 races only. The deployed identity calibration stays the baseline.",
