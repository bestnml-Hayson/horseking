        "calibration_method": "platt"
      },
      "experiments": {
        "platt_calibration": { "enabled": true }
      }
    },
    "exp_availability_renorm": {
      "description": "Phase 1 flag (off by default): drop the weights of factors whose inputs are missing and renormalise. Measured worse OOS (+0.022 NLL) as availability_renorm in the Phase-2 ablation; kept behind a flag so it can be re-tested.",
      "extends": "current_v586",
      "experiments": {
        "availability_renorm": { "enabled": true }
      }
    },
    "exp_timing_fusion": {
      "description": "Phase 1 flag (off by default): market weight depends on odds availability and time to post - 0 when odds are missing or coverage < 80%, 0.55 when more than two hours out, 0.80 inside two hours. Cannot be backtested until >=50 races carry genuine pre-race odds timestamps.",
      "extends": "current_v586",
      "experiments": {
        "timing_fusion": { "enabled": true }
      }
    },
    "exp_extreme_favourite_guard": {
      "description": "Phase 1 flag (off by default): soft cap on model weight for favourites priced below 1.6. Only three OOS races fall in the band, so it stays off until the sample grows.",
